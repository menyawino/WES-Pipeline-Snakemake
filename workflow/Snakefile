############################
####### Loading data #######
############################

# import necessary modules to process sample data
from scripts.sample_processing import get_sample_data
import os
import re

# Resolve sample metadata locally unless explicitly overridden.
samplesfile = config.get(
    "samplesfile",
    os.path.abspath(os.path.join(workflow.basedir, "..", "samples.csv")),
)

# get input directory
configfile: "workflow/config.yml"
inputdir = config["inputdir"]

# get sample data
sample_processing_cfg = config.get("sample_processing", {})
samples_data = get_sample_data(
    samplesfile,
    inputdir,
    lanes=sample_processing_cfg.get("lanes", [1, 2, 3, 4]),
    fail_on_missing=sample_processing_cfg.get("fail_on_missing", False),
)

# make lists for needed data
# get sample mrn without the _S17 (e.g., 20AD07372_S17 -> 20AD07372)
raw_samples = samples_data['sample'].unique().tolist() if not samples_data.empty else []
sample_mrn = [x.rsplit('_S', 1)[0] for x in raw_samples]
lane = samples_data['lane'].unique().tolist() if not samples_data.empty else []
read = samples_data['read'].unique().tolist() if not samples_data.empty else []

# concatenate the sample and sample_filename lists such that each element is a string of {sample}/{sample_filename}
sample_filename = [f"{x}/{y}" for x, y in zip(sample_mrn, raw_samples)]

pattern_mrn = '|'.join([re.escape(x) for x in sample_mrn]) if sample_mrn else r".*"
pattern_lane = '|'.join([re.escape(x) for x in lane]) if lane else r".*"
pattern_read = '|'.join([re.escape(x) for x in read]) if read else r".*"
pattern_sf = '|'.join([re.escape(x) for x in sample_filename]) if sample_filename else r".*"

wildcard_constraints:
    sample_mrn=pattern_mrn,
    lane=pattern_lane,
    read=pattern_read,
    sample_filename=pattern_sf

############################
####### Configuration ######
############################

# change this parameter to the path of the config file using
# set automatically by the python wrapper script

configfile: "workflow/config.yml"

############################
####### Include rules ######
############################

include: "rules/000_ref.smk"
include: "rules/001_qc.smk"
include: "rules/002_trimming.smk"
include: "rules/003_posttrim_qc.smk"
include: "rules/004_alignment.smk"
include: "rules/005_bam_prep.smk"
include: "rules/006_bam_qc.smk"
include: "rules/007_variant_calling.smk"
include: "rules/008_variant_filtering.smk"
# include: "rules/009_annotation.smk"
include: "rules/010_summary.smk"

############################
######### Workflow #########
############################
rule all:
    input:
        expand(rules.raw_fastqc.output.html, sample_filename=sample_filename, lane=lane, R=read),
        expand(rules.posttrim_fastqc.output.html, sample=sample_filename, lane=lane, R=read),
        expand(rules.bwa_mem.output.bam, sample=sample_filename, lane=lane),
        expand(rules.flagstat_original.output.flagstat_original, sample=sample_filename),
        expand(rules.flagstat_target.output.flagstat_target, sample=sample_filename),
        expand(rules.flagstat_prot_coding.output.flagstat_prot_coding, sample=sample_filename),
        expand(rules.flagstat_canon_tran.output.flagstat_canon_tran, sample=sample_filename),
        expand(rules.depth_of_coverage.output.depth_of_coverage, sample=sample_filename),
        expand(rules.depth_of_coverage_target.output.depth_of_coverage_target, sample=sample_filename),
        expand(rules.mean_coverage_per_exon.output.mean_coverage, sample=sample_filename),
        expand(rules.mean_coverage_per_exon_target.output.mean_coverage_target, sample=sample_filename),
        expand(rules.collect_alignment_summary_metrics.output.alignment_summary_metrics, sample=sample_filename),
        expand(rules.collect_alignment_summary_metrics_target.output.alignment_summary_metrics_target, sample=sample_filename),
        expand(rules.filter_snps.output.filtered_snp_vcf, sample=sample_filename),
        expand(rules.filter_indels.output.filtered_indel_vcf, sample=sample_filename),
        expand(rules.summarize_variants.output.report_md, sample=sample_filename),
        expand(rules.summarize_variants.output.summary_tsv, sample=sample_filename),
        expand(rules.summarize_variants.output.summary_json, sample=sample_filename),
        rules.aggregate_variant_summaries.output.cohort_report,
        rules.aggregate_variant_summaries.output.cohort_table,
        rules.aggregate_variant_summaries.output.cohort_json,
        rules.aggregate_variant_summaries.output.cohort_dashboard

