############################
####### Loading data #######
############################

# import necessary modules to process sample data
from scripts.sample_processing import get_sample_data
import os
import re

# Resolve sample metadata locally unless explicitly overridden.
samplesfile = config.get(
    "samplesfile",
    os.path.abspath(os.path.join(workflow.basedir, "..", "samples.csv")),
)

# get input directory
configfile: "workflow/config.yml"
inputdir = config["inputdir"]

# get sample data
sample_processing_cfg = config.get("sample_processing", {})
samples_data = get_sample_data(
    samplesfile,
    inputdir,
    lanes=sample_processing_cfg.get("lanes", [1, 2, 3, 4]),
    fail_on_missing=sample_processing_cfg.get("fail_on_missing", False),
)

# make lists for needed data
# get sample mrn without the _S17 (e.g., 20AD07372_S17 -> 20AD07372)
raw_samples = samples_data['sample'].unique().tolist() if not samples_data.empty else []
sample_mrn = [x.rsplit('_S', 1)[0] for x in raw_samples]
lane = samples_data['lane'].unique().tolist() if not samples_data.empty else []
read = samples_data['read'].unique().tolist() if not samples_data.empty else []

# concatenate the sample and sample_filename lists such that each element is a string of {sample}/{sample_filename}
sample_filename = [f"{x}/{y}" for x, y in zip(sample_mrn, raw_samples)]

fastq_lookup = {}
if not samples_data.empty:
    for _, row in samples_data.iterrows():
        s_raw = str(row['sample'])
        s_mrn = s_raw.rsplit('_S', 1)[0]
        s_lane = str(row['lane'])
        s_read = str(row['read'])
        f_path = str(row['file'])
        fastq_lookup[(s_mrn, s_lane, s_read)] = f_path
        fastq_lookup[(s_raw, s_lane, s_read)] = f_path
        fastq_lookup[(f"{s_mrn}/{s_raw}", s_lane, s_read)] = f_path

def get_raw_fastqc_input(wildcards):
    key = (wildcards.sample_filename, wildcards.lane, wildcards.R)
    if key in fastq_lookup:
        return fastq_lookup[key]
    return f"{config['inputdir']}/{wildcards.sample_filename}_{wildcards.lane}_{wildcards.R}_001.fastq.gz"

def get_trimming_r1(wildcards):
    key = (wildcards.sample, wildcards.lane, "R1")
    if key in fastq_lookup:
        return fastq_lookup[key]
    s_raw = wildcards.sample.split('/')[-1] if '/' in wildcards.sample else wildcards.sample
    if (s_raw, wildcards.lane, "R1") in fastq_lookup:
        return fastq_lookup[(s_raw, wildcards.lane, "R1")]
    return f"{config['inputdir']}/{wildcards.sample}_{wildcards.lane}_R1_001.fastq.gz"

def get_trimming_r2(wildcards):
    key = (wildcards.sample, wildcards.lane, "R2")
    if key in fastq_lookup:
        return fastq_lookup[key]
    s_raw = wildcards.sample.split('/')[-1] if '/' in wildcards.sample else wildcards.sample
    if (s_raw, wildcards.lane, "R2") in fastq_lookup:
        return fastq_lookup[(s_raw, wildcards.lane, "R2")]
    return f"{config['inputdir']}/{wildcards.sample}_{wildcards.lane}_R2_001.fastq.gz"

pattern_mrn = '|'.join([re.escape(x) for x in sample_mrn]) if sample_mrn else r".*"
pattern_lane = '|'.join([re.escape(x) for x in lane]) if lane else r".*"
pattern_read = '|'.join([re.escape(x) for x in read]) if read else r".*"
pattern_sf = '|'.join([re.escape(x) for x in sample_filename]) if sample_filename else r".*"

wildcard_constraints:
    sample_mrn=pattern_mrn,
    lane=pattern_lane,
    read=pattern_read,
    sample_filename=pattern_sf

# Normalize reference and resource paths to absolute paths
for k in ["reference_genome", "icc_panel", "cds_panel", "canontran_panel", "dbsnp", "omni", "tenk", "tenk_indel", "hapmap", "mills", "canonical_transcripts", "protein_coding"]:
    if k in config and config[k] and not os.path.isabs(config[k]):
        config[k] = os.path.abspath(os.path.join(workflow.basedir, "..", config[k]))

############################
####### Include rules ######
############################

include: "rules/000_ref.smk"
include: "rules/001_qc.smk"
include: "rules/002_trimming.smk"
include: "rules/003_posttrim_qc.smk"
include: "rules/004_alignment.smk"
include: "rules/005_bam_prep.smk"
include: "rules/006_bam_qc.smk"
include: "rules/007_variant_calling.smk"
include: "rules/008_variant_filtering.smk"
include: "rules/009_annotation.smk"
include: "rules/010_summary.smk"
include: "rules/011_multiqc.smk"

############################
######### Workflow #########
############################
rule all:
    input:
        expand(rules.trimming_fp.output.report, sample=sample_filename, lane=lane),
        expand(rules.trimming_fp.output.json, sample=sample_filename, lane=lane),
        expand(rules.bwa_mem.output.bam, sample=sample_filename, lane=lane),
        expand(rules.flagstat_original.output.flagstat_original, sample=sample_filename),
        expand(rules.flagstat_target.output.flagstat_target, sample=sample_filename),
        expand(rules.flagstat_prot_coding.output.flagstat_prot_coding, sample=sample_filename),
        expand(rules.flagstat_canon_tran.output.flagstat_canon_tran, sample=sample_filename),
        expand(rules.fast_bam_qc_prot_coding.output.depth_of_coverage, sample=sample_filename),
        expand(rules.fast_bam_qc_target.output.depth_of_coverage_target, sample=sample_filename),
        expand(rules.mean_coverage_per_exon.output.mean_coverage, sample=sample_filename),
        expand(rules.mean_coverage_per_exon_target.output.mean_coverage_target, sample=sample_filename),
        expand(rules.fast_bam_qc_prot_coding.output.alignment_summary_metrics, sample=sample_filename),
        expand(rules.fast_bam_qc_target.output.alignment_summary_metrics_target, sample=sample_filename),
        expand(rules.qc_report.output.qc_metrics, sample=sample_filename),
        expand(rules.filter_snps.output.filtered_snp_vcf, sample=sample_filename),
        expand(rules.filter_indels.output.filtered_indel_vcf, sample=sample_filename),
        expand(rules.vep_genebe_annotate_variants.output.vep_vcf, sample=sample_filename),
        expand(rules.vep_genebe_annotate_variants.output.acmg_tsv, sample=sample_filename),
        rules.aggregate_acmg_annotations.output.cohort_report,
        rules.aggregate_acmg_annotations.output.cohort_table,
        rules.aggregate_acmg_annotations.output.cohort_json,
        expand(rules.summarize_variants.output.report_md, sample=sample_filename),
        expand(rules.summarize_variants.output.summary_tsv, sample=sample_filename),
        expand(rules.summarize_variants.output.summary_json, sample=sample_filename),
        rules.aggregate_variant_summaries.output.cohort_report,
        rules.aggregate_variant_summaries.output.cohort_table,
        rules.aggregate_variant_summaries.output.cohort_json,
        rules.multiqc_report.output.html

onsuccess:
    import shutil
    print("\n[INFO] Workflow complete! Cleaning up intermediate HaplotypeCaller chunks...")
    for s in sample_filename:
        chunk_dir = os.path.join(config["outdir"], "analysis", "005_variant_calling", s, "chunks")
        if os.path.isdir(chunk_dir):
            shutil.rmtree(chunk_dir, ignore_errors=True)
    intervals_dir = os.path.join(config["outdir"], "analysis", "000_ref", "intervals")
    if os.path.isdir(intervals_dir):
        shutil.rmtree(intervals_dir, ignore_errors=True)
    print("[INFO] Intermediate chunks cleaned up successfully.")

    try:
        from scripts.aggregate import create_analysis_report
        create_analysis_report(config["outdir"])
    except Exception as e:
        print(f"[WARNING] Could not generate analysis report: {e}")

    try:
        from scripts.notifications import send_email_notification
        send_email_notification(config, status="SUCCESS", samples=sample_mrn)
    except Exception as e:
        print(f"[WARNING] Could not trigger onsuccess notification: {e}")

onerror:
    try:
        from scripts.notifications import send_email_notification
        log_file = getattr(workflow, "logfile", None) or os.path.join(config["outdir"], "logs")
        send_email_notification(config, status="FAILURE", log_file=str(log_file), samples=sample_mrn)
    except Exception as e:
        print(f"[WARNING] Could not trigger onerror notification: {e}")